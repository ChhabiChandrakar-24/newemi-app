# Nginx configuration example for frontend-production Single Page Application (SPA)
# Place this inside your server block (e.g., /etc/nginx/conf.d/emi.conf or /etc/nginx/sites-available/default)

server {
    listen 80;
    server_name emi.geetaforgetech.com; # Or your server IP / domain

    root /var/www/myproject/frontend-production;
    index index.html;

    # Static assets with caching
    location ~* \.(?:css|js|svg|png|jpg|jpeg|gif|webp|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    # API Proxy to Laravel backend (if backend is on the same machine)
    location /api/ {
        proxy_pass http://127.0.0.1:8000; # Or fastcgi_pass unix:/var/run/php-fpm/www.sock;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Single Page App routing: fallback all routes to index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
