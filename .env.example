# BOOTSTRAP SERVER SETTINGS (required before the Admin Panel can run)
APP_NAME="EMI Control Center"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://emi.geetaforgetech.com
APP_VERSION=1.0.0
CORS_ALLOWED_ORIGINS=https://emi.geetaforgetech.com

# Synthetic development/test data only. Replace before sharing an environment.
DEMO_PASSWORD=Demo@12345678
DEMO_PLATFORM_ADMIN_EMAIL=demo.superadmin@example.test
DEMO_SEED_ALLOWED=false

FIREBASE_ENABLED=true
FIREBASE_PROJECT_ID=my-test-app-9c548
FIREBASE_CREDENTIALS=D:\client_projects1\backend\storage\app\firebase-service-account.json

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=emi_locking
DB_USERNAME=emi_app
DB_PASSWORD=change_me

SANCTUM_EXPIRATION=1440

# Optional local/development bootstrap account. No production default is provided.
DEV_SUPER_ADMIN_NAME="Development Super Admin"
DEV_SUPER_ADMIN_EMAIL=
DEV_SUPER_ADMIN_PASSWORD=

DEVICE_HEARTBEAT_TIMEOUT_MINUTES=30
DEVICE_ENROLLMENT_TOKEN_TTL_MINUTES=30
DEVICE_CREDENTIAL_TTL_DAYS=365
DEVICE_COMMAND_TTL_MINUTES=60
DEVICE_COMMAND_MAX_RETRIES=3
DEVICE_COMMAND_ACK_TIMEOUT_MINUTES=5
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=
DEVICE_LOCATION_RETENTION_DAYS=30
LOCATION_MIN_INTERVAL_MINUTES=60
LOCATION_MIN_DISTANCE_METERS=250
DEVICE_MIN_AGENT_VERSION=

# Consent-to-manage: versions, document URLs and enforcement flag shown on the device
DEVICE_CONSENT_REQUIRED=true
DEVICE_CONSENT_TERMS_VERSION=1.0
DEVICE_CONSENT_PRIVACY_VERSION=1.0
DEVICE_CONSENT_TERMS_URL=
DEVICE_CONSENT_PRIVACY_URL=

# Data retention applied daily after EMI completion/release
DEVICE_RETENTION_ENABLED=true

# Re-enrollment token lifetime for supported device recovery flows
DEVICE_RE_ENROLL_TOKEN_TTL_MINUTES=15

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Private backup storage. Keep encryption password in a production secret manager.
BACKUP_ENABLED=true
BACKUP_DISK=local
BACKUP_RETENTION_DAYS=14
BACKUP_ENCRYPTION_PASSWORD=
MYSQLDUMP_BINARY=mysqldump
GENERATED_REPORT_RETENTION_DAYS=7

# ADMIN PANEL RUNTIME SETTINGS include company, Firebase Admin, SMTP, SMS,
# maps, payment provider, device policy, notifications and location policy.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# =============================================================================
# PRODUCTION ENVIRONMENT BLOCK (managed-services secrets)
# =============================================================================
# Base URL used by the Android-agent to reach this backend
API_BASE_URL=https://emi.geetaforgetech.com/api/v1/
# Production database connection string (managed MySQL/PostgreSQL service)
DATABASE_URL=mysql://user:password@host:3306/emi_locking
# JWT secret for validating Android-agent/device identity tokens
JWT_SECRET=
# Payment gateway API keys (Razorpay/Stripe provider credentials)
PAYMENT_GATEWAY_KEYS=
# Notification provider keys (Firebase Cloud Messaging, SMS gateway, SMTP)
NOTIFICATION_KEYS=
# Encryption keys for device credentials and sensitive at-rest fields
ENCRYPTION_KEYS=
# Android Enterprise managed-configuration JSON applied to the agent APK
ANDROID_ENTERPRISE_CONFIGURATION=